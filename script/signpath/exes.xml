<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "exes", the signing step of
  .github/workflows/solo-package.yml. The artifact is the folder dist/to-sign:
  Solo's own exes, built from this repository, which the portable zip then
  carries signed. conpty.dll and OpenConsole.exe aren't here: Microsoft
  signs them.

  Paste it into the SignPath project as the artifact configuration with the
  slug "exes". The version parameter is Solo's version (crates/zed/Cargo.toml).
  Solo's five exes all carry a version resource (crates/windows_resources)
  with product name "Solo" and Solo's version as product and file version,
  so each is matched by product name and version, as SignPath Foundation
  asks (the same product name and product version on every signed file);
  solo-package.yml checks the same before uploading.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="solo.exe" product-name="Solo" product-version="${version}" file-version="${version}">
      <authenticode-sign />
    </pe-file>
    <pe-file path="solo-cli.exe" product-name="Solo" product-version="${version}" file-version="${version}">
      <authenticode-sign />
    </pe-file>
    <pe-file path="solo-agent-hook.exe" product-name="Solo" product-version="${version}" file-version="${version}">
      <authenticode-sign />
    </pe-file>
    <pe-file path="solo-update-helper.exe" product-name="Solo" product-version="${version}" file-version="${version}">
      <authenticode-sign />
    </pe-file>
    <pe-file path="solo-terminal-host.exe" product-name="Solo" product-version="${version}" file-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
